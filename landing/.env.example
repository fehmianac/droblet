# Public origin of the site (canonical, hreflang, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://droblet.alatech.co

# API the browser calls from /delete-account, /reset-password and /invite. No trailing slash.
# Empty: those pages say "currently unavailable" instead of showing a form.
# Dev stack: https://b8lvaj4r5e.execute-api.eu-central-1.amazonaws.com
NEXT_PUBLIC_API_BASE_URL=

# Store listings. Empty: the button is shown disabled with "Yakında" / "Coming soon".
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Footer "İletişim" / "Contact" (mailto). Empty: the link is not rendered.
NEXT_PUBLIC_CONTACT_EMAIL=
