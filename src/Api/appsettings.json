{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "System": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "Jwt": { "Issuer": "droblet", "Audience": "droblet-app", "ExpirationMinutes": 60, "RefreshTokenExpirationDays": 60 },
  "App": {
    "PasswordResetUrl": "https://droblet.alatech.co/reset-password",
    "Scheme": "droplet",
    "BundleId": "com.alatech.droplet"
  },
  "AppleAuth": { "BundleId": "com.alatech.droplet" },
  "GoogleAuth": { "AndroidPackage": "com.alatech.droplet", "ClientIds": [] },
  "Email": { "Provider": "SendGrid", "From": "Droblet <no-reply@droblet.alatech.co>" },
  "Entitlements": { "Premium": { "TryOnCreditsPerMonth": 30 }, "Free": { "ItemRecognitionLimit": 10 } },
  "Packing": { "CabinMaxItems": 12, "MaxTripDays": 21 },
  "Palette": { "NeutralsCountAsCompatible": true, "NeutralColorIds": [] },
  "Wardrobe": { "MaxBatchUpload": 30, "MaxSplitPieces": 6, "SlotMapping": { "Beachwear": [ "Top", "Bottom" ], "Skiwear": [ "Top", "Bottom", "Outerwear" ] } },
  "Store": {
    "ProductIds": { "Premium": [ "com.alatech.droplet.premium.monthly", "com.alatech.droplet.premium.yearly" ] },
    "CreditPacks": { "com.alatech.droplet.credits.20": 20 }
  },
  "Photos": {
    "UploadUrlTtlSeconds": 300,
    "ReadUrlTtlSeconds": 300,
    "MaxUploadBytes": 10485760,
    "AllowedContentTypes": [ "image/jpeg", "image/png" ]
  },
  "AuthRateLimits": { "LoginPerEmailPer15Minutes": 10, "LoginPerIpPer15Minutes": 50, "RegisterPerIpPerHour": 20, "ForgotPerEmailPerHour": 3 },
  "Affiliate": { "DefaultCommissionRateBps": 0, "Brands": {} },
  "Localization": { "SupportedLanguages": [ "tr", "en" ], "DefaultLanguage": "tr" },
  "AdminJwt": { "Issuer": "droblet-admin", "Audience": "droblet-admin-panel", "AccessTokenMinutes": 15, "RefreshTokenHours": 12 },
  "AdminAuth": { "PanelUrl": "https://droblet-admin.alatech.co", "CodeTtlMinutes": 10, "CodeMaxAttempts": 5 },
  "Catalog": { "PageSize": 24, "MaxPageSize": 60, "CacheSeconds": 60, "MaxCartLines": 100, "MaxWatchItems": 200, "BulkUpsertMax": 200 },
  "Social": {
    "MaxFollowing": 500, "FeedPageSize": 20, "SuggestedPageSize": 20, "SuggestedCandidateLimit": 100, "SearchPageSize": 20,
    "InviteUrl": "https://droblet.alatech.co/i", "InviteAttributionWindowDays": 30, "ReportsPerDay": 20, "InviteResolvePerIpPerHour": 60
  },
  "Weather": { "Provider": "OpenMeteo", "CacheMinutes": 60 },
  "Notifications": { "DefaultMorningLocal": "07:30", "DefaultTimeZone": "Europe/Istanbul", "MaxDevicesPerTenant": 10 }
}
