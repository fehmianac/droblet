{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "System": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "Jwt": { "Issuer": "droblet", "Audience": "droblet-app", "ExpirationMinutes": 60, "RefreshTokenExpirationDays": 60 },
  "App": {
    "PasswordResetUrl": "https://droplet.alatech.co/reset-password",
    "Scheme": "droplet",
    "BundleId": "com.alatech.droplet"
  },
  "AppleAuth": { "BundleId": "com.alatech.droplet" },
  "GoogleAuth": { "AndroidPackage": "com.alatech.droplet", "ClientIds": [] },
  "Email": { "Provider": "SendGrid", "From": "Droblet <no-reply@droplet.alatech.co>" },
  "Entitlements": { "Premium": { "TryOnCreditsPerMonth": 30 } },
  "Store": {
    "ProductIds": { "Premium": [ "com.alatech.droplet.premium.monthly", "com.alatech.droplet.premium.yearly" ] },
    "CreditPacks": { "com.alatech.droplet.credits.20": 20 }
  },
  "Photos": {
    "UploadUrlTtlSeconds": 300,
    "ReadUrlTtlSeconds": 300,
    "MaxUploadBytes": 10485760,
    "AllowedContentTypes": [ "image/jpeg", "image/png" ]
  },
  "AuthRateLimits": { "LoginPerEmailPer15Minutes": 10, "LoginPerIpPer15Minutes": 50, "RegisterPerIpPerHour": 20, "ForgotPerEmailPerHour": 3 },
  "Affiliate": { "DefaultCommissionRateBps": 0, "Brands": {} }
}
