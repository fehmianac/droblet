 "notes": {
  "t_logo": {"x": 0, "y": -1150, "text": "0 · Logo", "kind": "title1", "maxW": 4620},
  "n_logo": {"x": 3280, "y": -900, "w": 420, "fill": "teal", "size": "m", "text": "Öneri: A — damla + askı\n\nTek bakışta iki fikri taşır: Droblet adındaki damla ve gardırop askısı. Sembol tek renkte, 29 px'te bile okunur; Cormorant wordmark mevcut kimlikle aynı. Uygulama başlıkları, karşılama ekranı, ikon ve landing A ile güncellendi."},
  "t_ds": {"x": 0, "y": 50, "text": "Tasarım sistemi", "kind": "title1", "maxW": 4620},
  "t_a": {"x": 0, "y": 1274, "text": "1 · Giriş ve onboarding", "kind": "title1", "maxW": 5090},
  "t_b": {"x": 0, "y": 2498, "text": "2 · Bugün", "kind": "title1", "maxW": 4620},
